*.csv
!resourceTypeOciConsole.csv
*.csv.gz
*.html
*.xlsx
*.xls
*.json
!config.example.json

# Archives (report zips can be very large; GitHub rejects files over 100 MB)
*.zip
*.gz
*.7z
*.tar

# Logs (-log option)
*.log
log.txt

# Local run script (copy runall.example.bat to runall.bat)
runall.bat

# Local settings (copy config.example.json to config.json)
config.json
config copy.json

